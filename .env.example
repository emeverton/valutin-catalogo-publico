# Server-only Linx Microvix B2C connection. Never expose these with NEXT_PUBLIC_.
LINX_B2C_ENDPOINT=
LINX_B2C_USER=
LINX_B2C_PASSWORD=
LINX_B2C_KEY=
LINX_B2C_CNPJ=
LINX_B2C_PORTAL=
# Optional: restrict available inventory to the configured Microvix deposit.
LINX_B2C_DEPOSITO=

# Public canonical URL used inside Meta and Google product feeds. This is not a secret.
CATALOG_PUBLIC_ORIGIN=https://www.valutin.com.br

# Editor da página Primavera–Verão. Usar senha diferente da do dashboard.
VALUTIN_EDITOR_PASSWORD=
VALUTIN_EDITOR_SECRET=
# Reutilizar o projeto Supabase correto já utilizado pelo site (somente no servidor).
VALUTIN_SUPABASE_URL=
VALUTIN_SUPABASE_SERVICE_ROLE_KEY=
